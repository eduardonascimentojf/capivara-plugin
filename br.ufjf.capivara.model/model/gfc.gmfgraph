<?xml version="1.0" encoding="ASCII"?>
<gmfgraph:Canvas xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:gmfgraph="http://www.eclipse.org/gmf/2006/GraphicalDefinition" name="gfc">
  <figures name="Default">
    <figures xsi:type="gmfgraph:PolylineDecoration" name="EdgeFigureTargetDecoration"/>
    <descriptors name="EntryNodeFigure">
      <actualFigure xsi:type="gmfgraph:Ellipse" name="EntryNodeFigure">
        <foregroundColor xsi:type="gmfgraph:RGBColor" red="40" green="167" blue="69"/>
        <preferredSize dx="40" dy="40"/>
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="EntryNodeLabelFigure" text="EntryNode"/>
      </actualFigure>
      <accessors accessor="getFigureEntryNodeLabelFigure" figure="//@figures.0/@descriptors.0/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="ProcessingNodeFigure">
      <actualFigure xsi:type="gmfgraph:Ellipse" name="ProcessingNodeFigure">
        <foregroundColor xsi:type="gmfgraph:RGBColor"/>
        <preferredSize dx="40" dy="40"/>
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="ProcessingNodeLabelFigure" text="ProcessingNode"/>
      </actualFigure>
      <accessors accessor="getFigureProcessingNodeLabelFigure" figure="//@figures.0/@descriptors.1/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="DecisionNodeFigure">
      <actualFigure xsi:type="gmfgraph:Ellipse" name="DecisionNodeFigure">
        <foregroundColor xsi:type="gmfgraph:RGBColor" green="123" blue="255"/>
        <preferredSize dx="40" dy="40"/>
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="DecisionNodeLabelFigure" text="DecisionNode"/>
      </actualFigure>
      <accessors accessor="getFigureDecisionNodeLabelFigure" figure="//@figures.0/@descriptors.2/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="LoopDecisionNodeFigure">
      <actualFigure xsi:type="gmfgraph:Ellipse" name="LoopDecisionNodeFigure">
        <foregroundColor xsi:type="gmfgraph:RGBColor" red="255" green="165"/>
        <preferredSize dx="40" dy="40"/>
        <border xsi:type="gmfgraph:MarginBorder">
          <insets top="5" left="5" bottom="5" right="5"/>
        </border>
        <children xsi:type="gmfgraph:Label" name="LoopDecisionNodeLabelFigure" text="LoopDecisionNode"/>
      </actualFigure>
      <accessors accessor="getFigureLoopDecisionNodeLabelFigure" figure="//@figures.0/@descriptors.3/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="ExitNodeFigure">
      <actualFigure xsi:type="gmfgraph:CustomFigure" name="ExitNodeFigure" qualifiedClassName="gfc.diagram.figures.DoubleEllipseFigure">
        <preferredSize dx="40" dy="40"/>
        <children xsi:type="gmfgraph:Label" name="ExitNodeLabelFigure" text="ExitNode"/>
      </actualFigure>
      <accessors accessor="getFigureExitNodeLabelFigure" figure="//@figures.0/@descriptors.4/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors name="EdgeFigure">
      <actualFigure xsi:type="gmfgraph:PolylineConnection" name="EdgeFigure" lineWidth="2" targetDecoration="//@figures.0/@figures.0">
        <foregroundColor xsi:type="gmfgraph:RGBColor"/>
      </actualFigure>
    </descriptors>
  </figures>
  <nodes name="EntryNode" figure="EntryNodeFigure">
    <facets xsi:type="gmfgraph:DefaultSizeFacet">
      <defaultSize dx="40" dy="40"/>
    </facets>
  </nodes>
  <nodes name="ProcessingNode" figure="ProcessingNodeFigure">
    <facets xsi:type="gmfgraph:DefaultSizeFacet">
      <defaultSize dx="40" dy="40"/>
    </facets>
  </nodes>
  <nodes name="DecisionNode" figure="DecisionNodeFigure">
    <facets xsi:type="gmfgraph:DefaultSizeFacet">
      <defaultSize dx="40" dy="40"/>
    </facets>
  </nodes>
  <nodes name="LoopDecisionNode" figure="LoopDecisionNodeFigure">
    <facets xsi:type="gmfgraph:DefaultSizeFacet">
      <defaultSize dx="40" dy="40"/>
    </facets>
  </nodes>
  <nodes name="ExitNode" figure="ExitNodeFigure">
    <facets xsi:type="gmfgraph:DefaultSizeFacet">
      <defaultSize dx="40" dy="40"/>
    </facets>
  </nodes>
  <connections name="Edge" figure="EdgeFigure"/>
  <labels name="EntryNodeLabel" figure="EntryNodeFigure" elementIcon="false" accessor="//@figures.0/@descriptors.0/@accessors.0"/>
  <labels name="ProcessingNodeLabel" figure="ProcessingNodeFigure" elementIcon="false" accessor="//@figures.0/@descriptors.1/@accessors.0"/>
  <labels name="DecisionNodeLabel" figure="DecisionNodeFigure" elementIcon="false" accessor="//@figures.0/@descriptors.2/@accessors.0"/>
  <labels name="LoopDecisionNodeLabel" figure="LoopDecisionNodeFigure" elementIcon="false" accessor="//@figures.0/@descriptors.3/@accessors.0"/>
  <labels name="ExitNodeLabel" figure="ExitNodeFigure" elementIcon="false" accessor="//@figures.0/@descriptors.4/@accessors.0"/>
</gmfgraph:Canvas>
