// Operação para carregar e modificar o gmfgen
operation main() {

    // Carrega o modelo gmfgen. O 'GMFGen' é o nome do metamodelo.
    // O 'GenEditorGenerator' é o elemento raiz do seu arquivo .gmfgen.
    var gmfgenModel = GMFGen!GenEditorGenerator.all.first();

    if (gmfgenModel.isUndefined()) {
        'Modelo GMFGen não encontrado!'.println();
        return;
    }

    // --- 1. Remove a Paleta ---
    if (gmfgenModel.palette.isDefined()) {
        'Removendo a paleta...'.println();
        delete gmfgenModel.palette;
    } else {
        'Nenhuma paleta encontrada para remover.'.println();
    }

    // --- 2. Remove todos os Menus de Contexto ---
    if (GMFGen!ContextMenu.all.isDefined() and GMFGen!ContextMenu.all.size() > 0) {
        'Removendo menus de contexto...'.println();
        // Deleta todas as instâncias de ContextMenu do modelo
        delete GMFGen!ContextMenu.all;
    } else {
        'Nenhum menu de contexto encontrado para remover.'.println();
    }
    
    'Limpeza do gmfgen concluída!'.println();
}

// Executa a operação principal
main();