<?xml version="1.0" encoding="ASCII"?>
<gmfmap:Mapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:gmfmap="http://www.eclipse.org/gmf/2008/mappings"
    xmlns:gmftool="http://www.eclipse.org/gmf/2005/ToolDefinition">
  <nodes>
    <containmentFeature
        href="gfc.ecore#//Flowchart/nodes"/>
    <ownedChild>
      <domainMetaElement
          href="gfc.ecore#//EntryNode"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="gfc.gmfgraph#EntryNodeLabel"/>
        <features
            href="gfc.ecore#//Node/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="gfc.gmftool#//@palette/@tools.0/@tools.1"/>
      <diagramNode
          href="gfc.gmfgraph#EntryNode"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="gfc.ecore#//Flowchart/nodes"/>
    <ownedChild>
      <domainMetaElement
          href="gfc.ecore#//ProcessingNode"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="gfc.gmfgraph#ProcessingNodeLabel"/>
        <features
            href="gfc.ecore#//Node/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="gfc.gmftool#//@palette/@tools.0/@tools.4"/>
      <diagramNode
          href="gfc.gmfgraph#ProcessingNode"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="gfc.ecore#//Flowchart/nodes"/>
    <ownedChild>
      <domainMetaElement
          href="gfc.ecore#//DecisionNode"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="gfc.gmfgraph#DecisionNodeLabel"/>
        <features
            href="gfc.ecore#//Node/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="gfc.gmftool#//@palette/@tools.0/@tools.0"/>
      <diagramNode
          href="gfc.gmfgraph#DecisionNode"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="gfc.ecore#//Flowchart/nodes"/>
    <ownedChild>
      <domainMetaElement
          href="gfc.ecore#//LoopDecisionNode"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="gfc.gmfgraph#LoopDecisionNodeLabel"/>
        <features
            href="gfc.ecore#//Node/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="gfc.gmftool#//@palette/@tools.0/@tools.3"/>
      <diagramNode
          href="gfc.gmfgraph#LoopDecisionNode"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="gfc.ecore#//Flowchart/nodes"/>
    <ownedChild>
      <domainMetaElement
          href="gfc.ecore#//ExitNode"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="gfc.gmfgraph#ExitNodeLabel"/>
        <features
            href="gfc.ecore#//Node/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="gfc.gmftool#//@palette/@tools.0/@tools.2"/>
      <diagramNode
          href="gfc.gmfgraph#ExitNode"/>
    </ownedChild>
  </nodes>
  <links>
    <domainMetaElement
        href="gfc.ecore#//Edge"/>
    <containmentFeature
        href="gfc.ecore#//Flowchart/edges"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="gfc.gmftool#//@palette/@tools.1/@tools.0"/>
    <diagramLink
        href="gfc.gmfgraph#Edge"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="gfc.ecore#//Edge/source"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="gfc.ecore#//Edge/target"/>
  </links>
  <diagram>
    <diagramCanvas
        href="gfc.gmfgraph#gfc"/>
    <domainModel
        href="gfc.ecore#/"/>
    <domainMetaElement
        href="gfc.ecore#//Flowchart"/>
    <palette
        href="gfc.gmftool#//@palette"/>
  </diagram>
</gmfmap:Mapping>
